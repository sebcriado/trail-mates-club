# ==========================================
# HikingHub - Environment Variables
# ==========================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ==========================================
# Supabase Configuration
# ==========================================
# Get these values from: https://app.supabase.com/project/YOUR_PROJECT/settings/api

# IMPORTANT: Use different Supabase projects for each environment:
# - Production: Your main production database
# - Staging: A separate project that mirrors production
# - Development: Can use staging or a dedicated dev project

# Production Supabase Project
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Example for staging (comment out production values and use these):
# VITE_SUPABASE_URL=https://your-staging-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-staging-anon-key-here
